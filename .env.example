# Ambiente de execução: "development" ou "production".
# Valores ausentes ou não reconhecidos são tratados como production (default seguro).
APP_ENV=development

# Caminho do banco em desenvolvimento.
# Default quando ausente ou vazio: ./teller-dev.db
DB_PATH_DEV=./teller-dev.db

# Caminho do banco em produção.
# Default quando ausente ou vazio: %APPDATA%\com.teller.app\teller.db
DB_PATH_PROD=
